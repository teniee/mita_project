# MITA MCP service — environment template (NO real values).
# Generate the secrets with: python scripts/mcp/generate_keys.py --out <new file>
# Full table: docs/chatgpt-app/staging.md

ENVIRONMENT=staging                       # staging | production
MCP_PUBLIC_URL=https://<public-host>      # origin only, no path; resource = <origin>/mcp
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db>   # this environment's DB only
MCP_AUTH_MODE=builtin

# secrets (generate_keys.py)
MCP_OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
MCP_LOGIN_CSRF_SECRET=<64 hex chars>
MCP_GRANT_FINGERPRINT_SECRET=<64 hex chars, different from the CSRF secret>
JWT_SECRET=<random, NOT the API's>
SECRET_KEY=<random, NOT the API's>
MCP_METRICS_TOKEN=<random>

# optional
MCP_SUPPORT_URL=https://<support page>
OPENAI_APPS_CHALLENGE_TOKEN=
MCP_TRUSTED_PROXY_HOPS=1
MCP_TOOL_CALLS_PER_MINUTE=60
MCP_LOGIN_ATTEMPTS_PER_MINUTE=10
MCP_OAUTH_REQUESTS_PER_MINUTE=30
LOG_LEVEL=INFO
