<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Lives in src/debug, so it is merged into debug APKs and
  is absent from every release artifact — the release build keeps
  src/main/res/xml/network_security_config.xml, which permits no cleartext at
  all.

  Why it exists: the live end-to-end suites must run against a DISPOSABLE
  backend (see integration_test/target_guard.dart, which refuses production
  outright). A disposable backend runs on this machine over plain HTTP, and
  the production config blocks cleartext globally, so a local E2E run could
  not reach it.

  Cleartext is opened for the loopback addresses only: 10.0.2.2 is the host
  machine as seen from an Android emulator. Everything else, production
  included, still requires HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
